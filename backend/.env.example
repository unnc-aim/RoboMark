# 数据库配置
DATABASE_URL=mysql+pymysql://root:password@localhost:3306/robomark

# JWT配置
SECRET_KEY=your-super-secret-key-change-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=1440

# 应用配置
DEBUG=true

# 图片预览缓存目录；留空使用 backend/uploads/image_previews，可安全清理。
IMAGE_PREVIEW_CACHE_DIR=

# 预标注凭据加密密钥：生成后保留，不随 JWT 密钥轮换
# python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
PREANNOTATION_ENCRYPTION_KEY=
PREANNOTATION_WORKER_CONCURRENCY=2
PREANNOTATION_ENDPOINT_CONCURRENCY=1

# 默认接口可选。留空对象时，仅使用页面保存到 MySQL 的配置。
# 完整字段见 docs/preannotation.md；认证信息写入数据库时自动加密。
PREANNOTATION_DEFAULT_PROFILE={}
# PREANNOTATION_DEFAULT_PROFILE={"name":"vLLM 默认接口","endpoint":"http://127.0.0.1:8001/v1/chat/completions","interface_type":"openai","model":"your-vision-model","api_key":"","response_path":"choices[0].message.content","coordinate_system":"relative_1000","box_format":"xyxy"}
