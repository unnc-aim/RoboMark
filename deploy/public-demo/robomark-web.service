[Unit]
Description=RoboMark single-port demo frontend and API gateway
After=network.target robomark-api.service
Wants=robomark-api.service

[Service]
User=robomark
Group=robomark
ExecStartPre=/www/server/nginx/sbin/nginx -p /root/robomark/run/ -c /root/robomark/app/deploy/public-demo/nginx.conf -t
ExecStart=/www/server/nginx/sbin/nginx -p /root/robomark/run/ -c /root/robomark/app/deploy/public-demo/nginx.conf -g "daemon off;"
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5
NoNewPrivileges=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/root/robomark/run

[Install]
WantedBy=multi-user.target
