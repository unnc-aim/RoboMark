[Unit]
Description=RoboMark public demo API
After=network.target

[Service]
User=robomark
Group=robomark
WorkingDirectory=/opt/robomark/app/backend
EnvironmentFile=/opt/robomark/shared/backend.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/robomark/venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 18000 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/opt/robomark/data /opt/robomark/run
UMask=0027

[Install]
WantedBy=multi-user.target
