[Unit]
Description=RoboMark public demo API
After=network.target

[Service]
User=robomark
Group=robomark
WorkingDirectory=/root/robomark/app/backend
EnvironmentFile=/root/robomark/shared/backend.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/root/robomark/venv/bin/python -m uvicorn app.main:app --host 127.0.0.1 --port 18000 --proxy-headers --forwarded-allow-ips 127.0.0.1
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/root/robomark/data /root/robomark/run
UMask=0027

[Install]
WantedBy=multi-user.target
