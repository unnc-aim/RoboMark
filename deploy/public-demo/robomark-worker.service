[Unit]
Description=RoboMark demo inference worker (run only when preparing data)
After=network.target robomark-api.service

[Service]
User=robomark
Group=robomark
WorkingDirectory=/root/robomark/app/backend
EnvironmentFile=/root/robomark/shared/backend.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/root/robomark/venv/bin/python -m app.preannotation_worker
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=read-only
ProtectSystem=strict
ReadWritePaths=/root/robomark/data /root/robomark/run
UMask=0027
